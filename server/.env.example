# ==============================================================================
# MEETING TRACKER - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' in your production or local server environment.
# On Render.com, set these variables in the Service Dashboard under 'Environment'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK & APPLICATION PORTS
# ------------------------------------------------------------------------------
# The port the Node.js Express & WebSocket server listens on.
# Render automatically injects the PORT environment variable in production (usually 10000).
PORT=3000

# Node execution environment ('development', 'production', or 'test').
# In production, this enables performance optimizations and disables verbose stack traces.
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONNECTION
# ------------------------------------------------------------------------------
# Standard PostgreSQL connection string format:
# postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
#
# If deploying on Render:
# Render creates an Internal Database URL for services in the same region, e.g.:
# postgresql://meeting_tracker_user:xxxx@dpg-xxxx-a/meeting_tracker
# Use the Internal Database URL on Render for lowest latency and zero egress cost.
# For local testing, use: postgres://postgres:postgres@localhost:5432/meeting_tracker
DATABASE_URL=postgresql://meeting_tracker_user:secret_password@dpg-your-db-instance-a:5432/meeting_tracker?sslmode=require

# Maximum connection pool size for pg client (recommended: 10 to 20 for standard tiers)
PG_MAX_CONNECTIONS=20

# Connection timeout in milliseconds
PG_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# High-entropy secret string used to sign and verify JSON Web Tokens (JWT).
# CRITICAL: Replace this with a cryptographically secure random string in production!
# Generate using: openssl rand -base64 48
JWT_SECRET=institutional_ultra_secure_jwt_secret_key_change_in_production_9283748293

# JWT token expiration window (e.g., '24h', '7d', '30d')
JWT_EXPIRES_IN=30d

# Salt rounds for bcrypt password hashing (10 is optimal for security/speed)
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS) & DOMAIN RESTRICTIONS
# ------------------------------------------------------------------------------
# Allowed origins for browser and client app requests.
# Set to '*' to allow requests from all desktop, mobile, and web clients,
# or specify your production domain, e.g. https://tracker.yourdomain.org
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 5. WEBSOCKET REALTIME CONFIGURATION
# ------------------------------------------------------------------------------
# WebSocket ping-pong heartbeat interval in milliseconds to keep connection alive
# through Cloudflare and Render proxy timeouts (Cloudflare drops idle WS after 100s).
WS_HEARTBEAT_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# 6. DEFAULT INSTITUTIONAL SETTINGS
# ------------------------------------------------------------------------------
# Default completion rule mode: 'ModeA_Strict' (Strict) or 'ModeB_Relaxed' (Relaxed)
DEFAULT_COMPLETION_RULE=ModeA_Strict
